<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>$(AssemblyName)</PackageId>
    <ApplicationIcon>FPTP.ico</ApplicationIcon>
    <Version>1.4.3.0</Version>

    <!-- 排除 publish 文件夹，不在 VS 中显示 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>

    <StartupObject>fptp.Program</StartupObject>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="5.0.0" />
    <PackageReference Include="System.Text.Json" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\lang.zh-CN.json">
      <LogicalName>fptp.Resources.lang.zh-CN.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\lang.en-US.json">
      <LogicalName>fptp.Resources.lang.en-US.json</LogicalName>
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="CHANGELOG.md;README.md;CONTRIBUTING.md;API.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>doc\%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="*.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>doc\%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="fptp.bat;register-path.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\donate.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>img\donate.jpg</TargetPath>
    </Content>
    <Content Include="Resources\lang.zh-CN.json;Resources\lang.en-US.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>lang\%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Windows.Forms" />
    <Using Include="System.Drawing" />
  </ItemGroup>

  <!-- 编译后整理目录：系统库 DLL 移入 lib\（App.config probing 指向 lib），运行时加载。
       Build 处理 bin\，Publish 处理发布目录（setup.iss 从 publish 取文件）。 -->
  <Target Name="OrganizeOutputDlls" AfterTargets="Build">
    <ItemGroup>
      <_LibDll Include="$(OutputPath)*.dll" />
    </ItemGroup>
    <Message Text="OrganizeOutputDlls: OutputPath=$(OutputPath) found @(_LibDll)" Importance="high" />
    <MakeDir Directories="$(OutputPath)lib" />
    <Move SourceFiles="@(_LibDll)" DestinationFolder="$(OutputPath)lib" />
  </Target>

  <Target Name="OrganizePublishDlls" AfterTargets="Publish">
    <ItemGroup>
      <_PubDll Include="$(PublishDir)*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)lib" />
    <Move SourceFiles="@(_PubDll)" DestinationFolder="$(PublishDir)lib" />
  </Target>

</Project>