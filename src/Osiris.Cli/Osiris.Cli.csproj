<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Osiris.Cli：命令行批处理（复用 Core 批处理管线，零 UI 依赖）。
    - System.CommandLine 解析：batch 命令（目录批量执行裁切/换底/排版滤镜链）
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Osiris.Cli</RootNamespace>
    <AssemblyName>Osiris.Cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osiris.Core\Osiris.Core.csproj" />
    <ProjectReference Include="..\Osiris.Engine.Skia\Osiris.Engine.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

</Project>
