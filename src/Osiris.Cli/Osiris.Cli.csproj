<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Osiris.Cli：命令行批处理（复用 Core 批处理管线，零 UI 依赖）。
    - System.CommandLine 解析：batch 命令（目录批量执行裁切/换底/排版滤镜链）
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Osiris.Cli</RootNamespace>
    <AssemblyName>Osiris.Cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osiris.Core\Osiris.Core.csproj" />
    <ProjectReference Include="..\Osiris.Engine.Skia\Osiris.Engine.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

  <!-- tie 运行时随 CLI 分发：tiec.exe 复制到输出 tools/tie/（TieRunner 定位 <运行目录>/tools/tie/tiec.exe），
       CLI 作为模块宿主同样加载 tie 脚本模块（type=script/language=tie），无随包 tiec 时需 FPTP_TIE_HOME -->
  <ItemGroup>
    <None Include="..\..\FpSDK\tools\tie\tiec.exe"
          CopyToOutputDirectory="PreserveNewest"
          Link="tools\tie\tiec.exe" />
  </ItemGroup>

</Project>
