<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Osiris.Engine.Skia：Skia 渲染引擎与编解码（无 Avalonia 依赖，可离屏测试）。
    - 渲染器：文档合成到 SKSurface（App 画布与导出共用）
    - 零拷贝视图：PixelSurface byte[] -> SKImage（SKData no-copy 包装）
    - 编解码：SkiaCodec（导入/导出 PNG/JPEG 等）
    SkiaSharp 版本必须与 Avalonia.Skia 12.1.1 对齐（3.119.4），避免类型分裂。
  -->
  <PropertyGroup>
    <RootNamespace>Osiris.Engine.Skia</RootNamespace>
    <AssemblyName>Osiris.Engine.Skia</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osiris.Core\Osiris.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
  </ItemGroup>

</Project>
