<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Osiris.Core：核心实现（无 UI 依赖）。
    - 文档 / 历史（COW 不可变 Layer + 命令栈）/ 成像 / 滤镜实现 / 批处理管线 / SettingRegistry
    - 仅引用 Abstractions（契约），被 App、Cli、测试共享。
  -->
  <PropertyGroup>
    <RootNamespace>Osiris.Core</RootNamespace>
    <AssemblyName>Osiris.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osiris.Abstractions\Osiris.Abstractions.csproj" />
    <!-- 算法库：ColorUtil/几何/floodfill/缩放/色彩变换（自本层迁移，供扩展模块复用） -->
    <ProjectReference Include="..\Osiris.Algorithms\Osiris.Algorithms.csproj" />
    <!-- tie:data 解析/写入库（DoNetTD）：tie:data 配置存储 + 模块清单解析（tie:data 全面替换 JSON） -->
    <ProjectReference Include="..\..\..\tie-DoNetTD\src\DoNetTD\DoNetTD.csproj" />
    <!-- tie:zd 压缩编码库（DoNetZD）：zd 配置交换/临时文件/备份（数据传输格式，与 tie:data 同数据面） -->
    <ProjectReference Include="..\..\..\DoNetZD\src\DoNetZD\DoNetZD.csproj" />
  </ItemGroup>

</Project>
