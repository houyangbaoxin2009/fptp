<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Osiris.App：Avalonia 跨平台桌面壳（Win/macOS/Linux）。
    - 画布：CanvasControl（ICustomDrawOperation + ISkiaSharpApiLeaseFeature 零拷贝直绘 SKCanvas）
    - MVVM：CommunityToolkit.Mvvm；DI：Microsoft.Extensions.DependencyInjection
    - 插件宿主：ALC 可卸载加载器 + [PluginExport] 扫描
    - 设置面板：SettingItem 类型树 + DataType 模板自动生成控件
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Osiris.App</RootNamespace>
    <AssemblyName>Osiris.App</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 应用图标：荷鲁斯之眼 Logo（Assets/App.ico，多尺寸 PNG 内嵌） -->
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logo 资源：窗口图标（avares://Osiris.App/Assets/App.ico）与主图 -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置语言包：langs/*.json 随构建复制到输出目录（JsonLocalizationService 按 AppContext.BaseDirectory/langs 加载） -->
    <None Include="langs\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osiris.Core\Osiris.Core.csproj" />
    <ProjectReference Include="..\Osiris.CoreModule\Osiris.CoreModule.csproj" />
    <ProjectReference Include="..\Osiris.Engine.Skia\Osiris.Engine.Skia.csproj" />
  </ItemGroup>

  <!--
    插件构建顺序依赖：仅保证扩展模块 DLL 先于壳构建完成（ReferenceOutputAssembly=false，
    不引入程序集引用——插件仍由 ModuleLoader 运行时加载，ABI 红线不变）。
    否则并行构建时插件 DLL 未就绪，CopyPluginsToOutput 复制/登记会缺失。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\Fptm\Fptm.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\FpEdit\FpEdit.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Itool\Itool.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\Fpter\Fpter.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Headless 冒烟测试访问壳内部类型（AppUiService/AppHostContext 等） -->
  <ItemGroup>
    <InternalsVisibleTo Include="Osiris.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Avalonia 12：Diagnostics 已并入主包（11.x 独立包停更），无需显式引用 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <!-- VSCode/VS 风格停靠系统（拖拽停靠/浮动/标签化） -->
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.1" />
  </ItemGroup>

  <!--
    扩展模块随发行复制：构建后把仓库根 plugins/bin/（内置扩展模块输出目录）
    复制到输出目录 plugins/（AppPaths.GetPluginDirectories 的程序集旁目录），
    保证 dotnet run / 发布产物运行时能发现扩展模块。
  -->
  <Target Name="CopyPluginsToOutput" AfterTargets="Build">
    <ItemGroup>
      <PluginFiles Include="$(MSBuildThisFileDirectory)..\..\plugins\bin\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFiles="@(PluginFiles->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    内置模块信任名单（防篡改）：构建后扫描输出目录 plugins/ 下各模块的 module.json，
    计算主 DLL（entryPoint）的 SHA-256，生成 trusted-modules.json 到输出目录。
    运行时 TrustedModuleSignatureValidator 校验模块哈希 ∈ 该名单（官方模块防替换）。
    无名单文件（未构建/开发）→ 校验降级放行，不锁死开发。
  -->
  <Target Name="GenerateTrustedModules" AfterTargets="CopyPluginsToOutput">
    <PropertyGroup>
      <TrustScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\scripts\generate-trusted-modules.ps1'))</TrustScript>
      <TrustRoot>$([System.IO.Path]::GetFullPath('$(OutDir)plugins'))</TrustRoot>
      <TrustOut>$([System.IO.Path]::GetFullPath('$(OutDir)trusted-modules.json'))</TrustOut>
      <!-- PowerShell 7（项目/构建环境统一用 pwsh；5.1 在 MSBuild Exec 下偶发模块 PATH 异常） -->
      <TrustHost>pwsh</TrustHost>
    </PropertyGroup>
    <Exec Command="&quot;$(TrustHost)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(TrustScript)&quot; -ModuleRoot &quot;$(TrustRoot)&quot; -Output &quot;$(TrustOut)&quot;" />
  </Target>

</Project>
