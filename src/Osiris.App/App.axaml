<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Osiris.App.App"
             RequestedThemeVariant="Default">

  <!-- Fluent 主题：跨平台统一外观（暗/亮跟随系统） -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

</Application>
