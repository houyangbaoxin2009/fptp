<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Osiris.App.ViewModels"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:mvvmDock="using:Dock.Model.Mvvm.Controls"
        x:Class="Osiris.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Osiris 2.1 - 模块化图像工作台"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600">

  <!-- 工作台装配模板：全部由模块贡献驱动，壳零业务 UI（Avalonia 12 编译绑定强制，各模板需 x:DataType） -->
  <Window.DataTemplates>
    <!-- 工具栏按钮模板（按 DataType 隐式匹配） -->
    <DataTemplate DataType="vm:CommandItemViewModel" x:DataType="vm:CommandItemViewModel">
      <Button Content="{Binding DisplayName}" Command="{Binding AvaloniaCommand}" Padding="10,2" Margin="2,0" />
    </DataTemplate>
    <!-- Dock 文档/工具内容模板：Dock 12 的 DocumentContentControl 以文档对象本身为内容，
         此处按具体类型渲染其 Context（画布控件 / 模块面板内容）。 -->
    <DataTemplate DataType="mvvmDock:Document" x:DataType="mvvmDock:Document">
      <ContentControl Content="{Binding Context}" />
    </DataTemplate>
    <DataTemplate DataType="mvvmDock:Tool" x:DataType="mvvmDock:Tool">
      <ContentControl Content="{Binding Context}" />
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <!-- 顶部菜单栏：容器 Style 递归设置 MenuItem 属性（官方分层菜单模式，避免隐式模板把 MenuItem 包进容器 Header） -->
    <Menu DockPanel.Dock="Top" ItemsSource="{Binding Menus}">
      <Menu.Styles>
        <Style Selector="MenuItem" x:DataType="vm:MenuNodeViewModel">
          <Setter Property="Header" Value="{Binding Title}" />
          <Setter Property="ItemsSource" Value="{Binding Children}" />
          <Setter Property="Command" Value="{Binding AvaloniaCommand}" />
        </Style>
      </Menu.Styles>
    </Menu>
    <!-- 顶部工具栏（Avalonia 12 已移除 ToolBar 控件，用横向 ItemsControl 替代） -->
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding ToolbarItems}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
    <!-- 底部状态栏（Avalonia 12 已移除 StatusBar 控件，用 Border 替代） -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#FF888888" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}" Margin="6,3" />
    </Border>
    <!-- 中央：VSCode/VS 风格停靠工作台（画布文档 + 全部模块面板/壳级工具窗口可拖拽停靠/浮动/标签化）。
         Layout 由 WorkbenchDockFactory 提供（创建时即完成 CreateLayout+InitLayout）。 -->
    <dock:DockControl x:Name="DockControl"
                      Factory="{Binding DockFactory}"
                      Layout="{Binding DockFactory.Layout}"
                      Margin="2" />
  </DockPanel>
</Window>
