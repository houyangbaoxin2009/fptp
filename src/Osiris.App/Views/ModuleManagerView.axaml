<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Osiris.App.ViewModels"
             xmlns:mod="using:Osiris.Abstractions.Modules"
             x:Class="Osiris.App.Views.ModuleManagerView"
             x:DataType="vm:ModuleManagerViewModel">

  <DockPanel>
    <!-- 底部操作栏（配置入口已在"工具/设置"菜单，此处不再重复） -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="8">
      <Button Content="{Binding BtnEnableDisable}" Command="{Binding ToggleEnabledCommand}" MinWidth="90" />
      <Button Content="{Binding BtnUninstall}" Click="OnUninstallClick" MinWidth="90" />
      <Button Content="{Binding BtnClose}" Click="OnCloseClick" MinWidth="90" />
    </StackPanel>

    <Grid ColumnDefinitions="260,8,*">
      <!-- 左侧模块列表 -->
      <ListBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule}">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="mod:ModuleRecord" x:DataType="mod:ModuleRecord">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="Bold" />
              <TextBlock Text="{Binding Id}" FontSize="10" Opacity="0.6" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- 右侧详情（编译绑定直接经 SelectedModule.X 访问，避免 DataContext 切换的 x:DataType 难题） -->
      <StackPanel Grid.Column="2" Margin="8" Spacing="6">
        <TextBlock Text="{Binding SelectedModule.Name}" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="{Binding SelectedModule.Id}" Opacity="0.7" />
        <TextBlock Text="{Binding VersionText}" />
        <TextBlock Text="{Binding KindText}" />
        <TextBlock Text="{Binding StatusText}" />
        <TextBlock Text="{Binding LanguageText}" />
        <TextBlock Text="{Binding SelectedModule.LoadPath}" FontSize="10" Opacity="0.5" TextWrapping="Wrap" />
        <TextBlock Text="{Binding HintText}"
                   FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,12,0,0" />
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
