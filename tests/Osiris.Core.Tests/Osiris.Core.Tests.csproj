<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Osiris.Core.Tests：核心逻辑单元测试（最高价值）。
    - PixelSurface/Selection 栅格化、HistoryStack、COW 语义、滤镜像素级断言、
      SettingRegistry 序列化往返与损坏恢复、批处理管线
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Osiris.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Osiris.Core\Osiris.Core.csproj" />
    <ProjectReference Include="..\..\src\Osiris.Algorithms\Osiris.Algorithms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- tie 运行桥测试资源：tiec.exe 复制到输出 tools/tie/（模拟宿主随包分发路径 TieRunner.FindTiec）；
       fptp_sdk.tie 供脚本 import（TieModuleTests 写临时 main.tie 时复制到同目录） -->
  <ItemGroup>
    <None Include="..\..\FpSDK\tools\tie\tiec.exe"
          CopyToOutputDirectory="PreserveNewest"
          Link="tools\tie\tiec.exe" />
    <None Include="..\..\FpSDK\templates\tie-module\fptp_sdk.tie"
          CopyToOutputDirectory="PreserveNewest"
          Link="tie\fptp_sdk.tie" />
  </ItemGroup>

</Project>
