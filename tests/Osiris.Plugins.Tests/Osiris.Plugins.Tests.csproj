<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Osiris.Plugins.Tests：插件宿主测试（ALC 可卸载承诺的唯一证明）。
    - 真实 ALC 加载 Fpter -> 跑滤镜 -> 卸载 -> WeakReference 断言可回收
    - 契约测试：反射断言插件程序集不引用 SkiaSharp/Avalonia（ABI 红线）
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>Osiris.Plugins.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Osiris.Core\Osiris.Core.csproj" />
    <!-- 工作流集成测试：直接实例化 fptm 换底/裁切/排版算法（走编译引用，不经 ALC） -->
    <ProjectReference Include="..\..\plugins\Fptm\Fptm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- 插件 UI 模块（fptm）引用 Avalonia：测试宿主须先加载 Avalonia（转发默认 ALC），否则模块 GetTypes 解析失败 -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
  </ItemGroup>

</Project>
