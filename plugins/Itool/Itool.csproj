<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Itool：画笔工具模块（fptm 拆出的工具+画笔部分）。
    - 提供 9 个编辑工具（选取/套索/智能框选/滴管/铅笔/钢笔/毛笔/刷子/颜料桶）+ 画笔窗口 + 颜料盘/预设。
    - 仅引用 Osiris.Abstractions + Osiris.Algorithms（ABI 红线：不引用 Core/Engine）。
    - 输出到 plugins/bin/Itool/ 子目录：与 Fptp.Plugins.Builtin 的 module.json 同名文件隔离，
      宿主 ModuleLoader.FindManifests 扫描"根 + 一级子目录"即可发现本模块清单。
  -->
  <PropertyGroup>
    <RootNamespace>Itool</RootNamespace>
    <AssemblyName>Itool</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\Itool\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Osiris.Abstractions\Osiris.Abstractions.csproj" />
    <!-- 算法库（ABI 红线允许：纯算法，零 UI/渲染依赖） -->
    <ProjectReference Include="..\..\src\Osiris.Algorithms\Osiris.Algorithms.csproj" />
  </ItemGroup>

  <!-- 扩展模块 UI 视图：允许引用 Avalonia（托管控件层，经 ALC 转发到默认上下文，
       类型同一性与宿主一致；仍禁止 SkiaSharp/Core/Engine——见 ABI 红线测试） -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 模块自带语言包：随模块分发（宿主加载模块后自动注册，合并进全局语言表） -->
    <None Include="langs\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
