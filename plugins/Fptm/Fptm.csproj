<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fptm：传统批处理 + 证件照工作流模块（换底色 / 智能裁切 / 排版，算法在 Workflow 目录）。
    原 9 个编辑工具已拆到 itool 模块，编辑命令已拆到 fpedit 模块。
    - 引用 Osiris.Abstractions + Osiris.Algorithms（ABI 红线：不引用 Core/Engine/Skia）。
    - 输出到 plugins/bin/Fptm/ 子目录：与 Fpter 的 module.json 同名文件隔离，
      宿主 ModuleLoader.FindManifests 扫描"根 + 一级子目录"即可发现本模块清单。
  -->
  <PropertyGroup>
    <RootNamespace>Fptm</RootNamespace>
    <AssemblyName>Fptm</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\Fptm\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Osiris.Abstractions\Osiris.Abstractions.csproj" />
    <!-- 算法库（ABI 红线允许：纯算法，零 UI/渲染依赖） -->
    <ProjectReference Include="..\..\src\Osiris.Algorithms\Osiris.Algorithms.csproj" />
  </ItemGroup>

  <!-- 扩展模块 UI 视图：允许引用 Avalonia（托管控件层，经 ALC 转发到默认上下文，
       类型同一性与宿主一致；仍禁止 SkiaSharp/Core/Engine——见 ABI 红线测试） -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="module.data.tie" CopyToOutputDirectory="PreserveNewest" />
    <!-- 模块自带语言包：随模块分发（宿主加载模块后自动注册，合并进全局语言表） -->
    <None Include="langs\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
