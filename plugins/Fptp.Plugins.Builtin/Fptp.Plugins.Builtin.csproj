<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fptp.Plugins.Builtin：内置证件照插件包（与第三方插件完全同级，狗食化 ALC 路径）。
    - 仅引用 Osiris.Abstractions（ABI 红线：不得引用 SkiaSharp/Avalonia）
    - 输出到仓库根 plugins/bin（宿主运行时扫描目录）
  -->
  <PropertyGroup>
    <RootNamespace>Fptp.Plugins.Builtin</RootNamespace>
    <AssemblyName>Fptp.Plugins.Builtin</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Osiris.Abstractions\Osiris.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- module.json 插件清单随程序集复制到输出目录（宿主扫描 LoadPath 时读取） -->
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 模块自带语言包：随模块分发（宿主加载模块后自动注册，合并进全局语言表） -->
    <None Include="langs\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
