<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fpter：内置滤镜模块（原 Fptp.Plugins.Builtin 改名 + 合并 Fptp.Filters 滤镜窗口而来）。
    - 提供滤镜窗口（可停靠，聚合全部 IFilterPlugin 的滤镜）+ 灰度 / 动漫滤镜（IFilterPlugin）。
    - 换底色 / 智能裁切 / 排版已迁移到 fptm 工作流模块，本模块不再承担。
    - 输出到 plugins/bin/Fpter/ 子目录，宿主 FindManifests 扫描一级子目录发现。
  -->
  <PropertyGroup>
    <RootNamespace>Fpter</RootNamespace>
    <AssemblyName>Fpter</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\Fpter\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Osiris.Abstractions\Osiris.Abstractions.csproj" />
  </ItemGroup>

  <!-- 滤镜窗口视图：允许引用 Avalonia（托管控件层，经 ALC 转发到默认上下文；
       类型同一性与宿主一致；仍禁止 SkiaSharp/Core/Engine——见 ABI 红线测试） -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- module.json 插件清单随程序集复制到输出目录（宿主扫描 LoadPath 时读取） -->
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 模块自带语言包：随模块分发（宿主加载模块后自动注册，合并进全局语言表） -->
    <None Include="langs\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>