<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FpEdit：编辑模块（fptm 拆出的编辑命令 + 操作面板部分）。
    - 提供 编辑命令（复制/粘贴/撤销/重做）+ 操作窗口面板 + 像素剪贴板。
    - 仅引用 Osiris.Abstractions（ABI 红线：不引用 Core/Engine/Skia/Avalonia）。
    - 输出到 plugins/bin/FpEdit/ 子目录：与 Fptp.Plugins.Builtin 的 module.json 同名文件隔离，
      宿主 ModuleLoader.FindManifests 扫描"根 + 一级子目录"即可发现本模块清单。
  -->
  <PropertyGroup>
    <RootNamespace>FpEdit</RootNamespace>
    <AssemblyName>FpEdit</AssemblyName>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\FpEdit\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Osiris.Abstractions\Osiris.Abstractions.csproj" />
    <!-- 算法库（ABI 红线允许：纯算法，零 UI/渲染依赖） -->
    <ProjectReference Include="..\..\src\Osiris.Algorithms\Osiris.Algorithms.csproj" />
  </ItemGroup>

  <!-- 扩展模块 UI 视图：允许引用 Avalonia（托管控件层，经 ALC 转发到默认上下文，
       类型同一性与宿主一致；仍禁止 SkiaSharp/Core/Engine——见 ABI 红线测试） -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 模块自带语言包：随模块分发（宿主加载模块后自动注册，合并进全局语言表） -->
    <None Include="langs\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
