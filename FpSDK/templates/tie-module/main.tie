type tie<logic>

// {{DisplayName}} —— tie 脚本插件（{{Id}}）
// tie 版本：Harbor-2026.1-preview.5（SDK：fptp_sdk.tie，v2 帧桥，零 tie-interp 依赖）
// 运行桥（FpSDK.TieKit.TieRunner，fptp.tie-bridge.v2）：
//   - 输入：stdin 一行 base64(tink 帧)，帧 payload = 宿主协议文本
//   - 输出：stdout 一行 base64(tink 帧)，payload = [tag][正文]，tag 0x00=OK / 0x01=ERR
// 依赖解析按工作目录（CWD）：std/tink.tie + rdu/crc.tie 随模板生成于本目录。
// 插件逻辑只需实现 process(src)；main 调 fptp.bridge(process) 完成
//   帧读取 → process → OK/ERR 应答帧。

import "fptp_sdk.tie" as fptp

// ==================== 插件逻辑 ====================

func process(src: string) -> string {
    // 参数自描述探测（宿主加载时发一次）：识别后返回 "params\n" + 参数声明行，
    // 宿主据此自动生成滤镜参数 UI。未声明参数的脚本可省略本分支。
    if fptp.data_get(src, "action", "") == "params" {
        return "params\n" + fptp.param_int("delta", "亮度增量", -255, 255, 20)
    }
    // TODO: 在此实现插件逻辑（src 为宿主传入的 tie:data / 协议文本，含声明参数的真实值；
    // 正式滤镜用 fptp.data_get_int(src,"delta",20) 读参数、处理像素后
    // fptp.data_make("pixels", ...) 返回）。echo 示例直接返回原文。
    return src
}

// ==================== 运行桥（勿删） ====================

func main() {
    fptp.bridge(process)
}